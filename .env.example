# Copy to .env.local and fill in values (Next.js loads .env.local automatically).
# Never commit .env.local or real secrets.
#
# Jira product settings (site URL, project key, field ids, assignee map) live in the database
# under Jira Integration (super admin). Do not put them here.

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL) — required for Prisma
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Auth (required)
# -----------------------------------------------------------------------------
# NextAuth session signing. Generate: npx auth secret
AUTH_SECRET=

# Optional dedicated AES key for Jira API tokens in Postgres (falls back to AUTH_SECRET).
# JIRA_TOKEN_ENCRYPTION_KEY=

# Public app URL in production (also helps Auth.js host trust).
# AUTH_URL=https://your-app.example.com

# Break-glass email(s) used when bootstrapping an empty access registry (comma-separated).
AUTH_SUPER_ADMIN_EMAIL=admin@example.com

# Sign-in email domain restriction (server). Required in production.
AUTH_ALLOWED_EMAIL_DOMAIN=example.com

# Sign-in email domain for client UI (must match AUTH_ALLOWED_EMAIL_DOMAIN).
NEXT_PUBLIC_AUTH_ALLOWED_EMAIL_DOMAIN=example.com

# First-boot only: allow writing a default registry when the DB has zero squads/users.
# ALLOW_REGISTRY_BOOTSTRAP=1

# Seed guard (also accepted as --confirm-seed on `npm run db:seed`).
# ALLOW_DB_SEED=1

# Default squad when none is selected.
DEFAULT_SQUAD_ID=ventures

# -----------------------------------------------------------------------------
# Identity service (optional) — squad roles / memberships
# -----------------------------------------------------------------------------
# IDENTITY_SERVICE_BASE_URL=https://your-identity-service.example.com/api
# IDENTITY_SERVICE_TOKEN=
# IDENTITY_SERVICE_TIMEOUT_MS=5000

# Optional: used only by local CLI scripts under scripts/ (not by the web app).
# JIRA_USER_EMAIL=
# JIRA_USER_API_TOKEN=
